<Project Sdk="Microsoft.NET.Sdk">

  <!-- Read-only live check against a running Voicemeeter: login, read, logout. Never writes. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The plugin excludes the SDK runtime asset; this exe needs it to load the plugin assembly. -->
    <PackageReference Include="LoupixDeck.PluginSdk" Version="1.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LoupixDeck.Plugin.Voicemeeter\LoupixDeck.Plugin.Voicemeeter.csproj" />
  </ItemGroup>

</Project>
