<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>default</LangVersion>
    <DebugType>embedded</DebugType>

    <!-- Produces a .deps.json and copies dependencies next to the plugin dll so
         the host's AssemblyDependencyResolver can find them. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <Version>1.0.0</Version>
    <Authors>vividflash</Authors>
    <Description>Voicemeeter strip and bus controls for LoupixDeck.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The host supplies the SDK assembly at runtime; never ship it. -->
    <PackageReference Include="LoupixDeck.PluginSdk" Version="1.25.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LoupixDeck.Plugin.Voicemeeter.Tests" />
    <InternalsVisibleTo Include="VmReadCheck" />
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
